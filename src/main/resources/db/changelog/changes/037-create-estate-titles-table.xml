<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        inventory.internal.domain.EstateTitle — one land title per estate.

        TITLE IS PER-ESTATE, NEVER PER-COMPANY. A developer can hold clean
        title on one estate and none at all on the next, so this cannot live
        on organizations. organization_documents carries the mirror of this
        rule — it deliberately holds corporate verification documents (CAC,
        TIN, SCUML) and no land title. The two halves are meant to be read
        together; see AGENTS.md.

        title_type values contain spaces and an apostrophe ("Governor's
        Consent"), which is exactly why this codebase maps enums with an
        explicit @JsonValue/@JsonCreator pair rather than a naming strategy.
        The constant name is what is stored (@Enumerated(STRING)).
    -->
    <changeSet id="037-create-estate-titles-table" author="landvault">
        <sql>
            CREATE TABLE estate_titles (
                id                       uuid NOT NULL,
                tenant_id                uuid,
                branch_id                uuid,
                created_at               timestamp(6) with time zone NOT NULL,
                updated_at               timestamp(6) with time zone,
                created_by               varchar(255),
                updated_by               varchar(255),
                deleted                  boolean NOT NULL,

                estate_id                uuid NOT NULL,
                title_type               varchar(40) NOT NULL,
                title_number             varchar(120),
                issued_date              date,
                survey_plan_document_id  uuid,
                deed_document_id         uuid,

                PRIMARY KEY (id)
            );

            COMMENT ON TABLE estate_titles IS
                'Land title evidence, per estate. Deliberately NOT on organizations: a company can hold clean title on one estate and none on another.';
            COMMENT ON COLUMN estate_titles.survey_plan_document_id IS
                'Opaque reference into the documents module — inventory does not resolve it and must not reach into that module to do so.';

            ALTER TABLE estate_titles ADD CONSTRAINT chk_estate_titles_title_type
                CHECK (title_type IN ('C_OF_O', 'R_OF_O', 'GOVERNORS_CONSENT', 'GAZETTE'));
        </sql>
        <rollback>
            DROP TABLE estate_titles;
        </rollback>
    </changeSet>

    <changeSet id="037-create-estate-titles-fk-indexes" author="landvault">
        <addForeignKeyConstraint
                baseTableName="estate_titles" baseColumnNames="estate_id"
                constraintName="fk_estate_titles_estate_id"
                referencedTableName="estates" referencedColumnNames="id"/>
        <createIndex indexName="idx_estate_titles_tenant_id" tableName="estate_titles">
            <column name="tenant_id"/>
        </createIndex>
        <!-- 1:1 with the estate — also serves as the FK's index. -->
        <addUniqueConstraint tableName="estate_titles" columnNames="estate_id"
                             constraintName="uq_estate_titles_estate_id"/>
    </changeSet>

</databaseChangeLog>
