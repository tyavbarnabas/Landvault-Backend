<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        identity.internal.domain.TwoFaChallenge — the pending-login handle
        issued when credentials are correct but 2FA has not yet been
        satisfied. Exchanged, together with a TOTP or recovery code, at
        POST /api/auth/2fa/verify for the real tokens.

        This table is a deliberate addition beyond the slice's stated two
        schema changes. The challenge is required to be SINGLE USE, and
        single use cannot be enforced by a self-contained signed token: a JWT
        is valid until it expires, replayable by anyone holding it. Storing
        it gives a consumed_at to set, exactly like refresh_tokens and
        otp_codes. See AGENTS.md.

        Holds only token_hash. The challenge carries NO authority of its own
        — it cannot authenticate any request; it only identifies which
        pending login a subsequent code belongs to.

        Not RLS-policied: issued and consumed during login, before any tenant
        scope exists — same bootstrapping shape as refresh_tokens.
    -->
    <changeSet id="031-create-two-fa-challenges-table" author="landvault">
        <sql>
            CREATE TABLE two_fa_challenges (
                id          uuid NOT NULL,
                tenant_id   uuid,
                branch_id   uuid,
                created_at  timestamp(6) with time zone NOT NULL,
                updated_at  timestamp(6) with time zone,
                created_by  varchar(255),
                updated_by  varchar(255),
                deleted     boolean NOT NULL,

                user_id     uuid NOT NULL,
                token_hash  varchar(255) NOT NULL,
                expires_at  timestamp(6) with time zone NOT NULL,
                consumed_at timestamp(6) with time zone,

                PRIMARY KEY (id)
            );

            COMMENT ON TABLE two_fa_challenges IS
                'Pending 2FA logins. A challenge proves the password step succeeded and nothing more — it grants no access on its own.';
            COMMENT ON COLUMN two_fa_challenges.consumed_at IS
                'Single use: set once exchanged for real tokens, so a leaked challenge cannot be replayed within its short lifetime.';
        </sql>
        <rollback>
            DROP TABLE two_fa_challenges;
        </rollback>
    </changeSet>

    <changeSet id="031-create-two-fa-challenges-fk-index" author="landvault">
        <addForeignKeyConstraint
                baseTableName="two_fa_challenges" baseColumnNames="user_id"
                constraintName="fk_two_fa_challenges_user_id"
                referencedTableName="users" referencedColumnNames="id"/>
        <createIndex indexName="idx_two_fa_challenges_user_id" tableName="two_fa_challenges">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
