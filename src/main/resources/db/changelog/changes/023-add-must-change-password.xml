<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        A bootstrap password (SuperAdminBootstrap) has passed through an
        environment variable, probably a shell history, and possibly a
        deployment log. must_change_password flags that account so the
        frontend can route to a change-password screen. Defaulted false so
        every existing/ordinary row is unaffected.

        NOT enforced at login in this slice — the change-password endpoint
        doesn't exist yet. See AGENTS.md for the open TODO; don't assume
        this column alone closes the gap.
    -->
    <changeSet id="023-add-must-change-password" author="landvault">
        <sql>
            ALTER TABLE users ADD COLUMN must_change_password boolean NOT NULL DEFAULT false;
        </sql>
        <rollback>
            ALTER TABLE users DROP COLUMN must_change_password;
        </rollback>
    </changeSet>

</databaseChangeLog>
