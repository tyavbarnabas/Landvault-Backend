<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        tenancy.internal.domain.OrganizationStateRegulator — a repeatable
        list of state-level real estate regulators an organization is
        registered with. LASRERA is not structurally special: it is simply
        a row with state = 'Lagos' and regulator_name = 'LASRERA'.

        Column shapes were taken directly from Hibernate's own DDL export
        for the current entity mapping (jakarta.persistence.schema-generation
        with ddl-auto=none), so they match exactly what ddl-auto=validate
        expects. Don't hand-tune a column without re-exporting and
        re-checking against that mapping.
    -->
    <changeSet id="007-create-organization-state-regulators-table" author="landvault">
        <sql>
            CREATE TABLE organization_state_regulators (
                id                    uuid NOT NULL,
                tenant_id             uuid,
                branch_id             uuid,
                created_at            timestamp(6) with time zone NOT NULL,
                updated_at            timestamp(6) with time zone,
                created_by            varchar(255),
                updated_by            varchar(255),
                deleted               boolean NOT NULL,

                organization_id       uuid NOT NULL,
                state                 varchar(100) NOT NULL,
                regulator_name        varchar(255) NOT NULL,
                registration_number   varchar(255) NOT NULL,
                document_id           uuid,

                PRIMARY KEY (id)
            );
        </sql>
        <rollback>
            DROP TABLE organization_state_regulators;
        </rollback>
    </changeSet>

    <changeSet id="007-create-organization-state-regulators-fk-indexes" author="landvault">
        <addForeignKeyConstraint
                baseTableName="organization_state_regulators" baseColumnNames="organization_id"
                constraintName="fk_organization_state_regulators_organization_id"
                referencedTableName="organizations" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="organization_state_regulators" baseColumnNames="document_id"
                constraintName="fk_organization_state_regulators_document_id"
                referencedTableName="organization_documents" referencedColumnNames="id"/>
        <createIndex indexName="idx_organization_state_regulators_organization_id" tableName="organization_state_regulators">
            <column name="organization_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="007-create-organization-state-regulators-unique" author="landvault">
        <addUniqueConstraint
                tableName="organization_state_regulators" columnNames="organization_id, state, regulator_name"
                constraintName="uq_organization_state_regulators_org_state_regulator"/>
    </changeSet>

</databaseChangeLog>
