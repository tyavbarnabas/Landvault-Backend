# Copy to .env and adjust as needed for local development.
SPRING_PROFILES_ACTIVE=dev
DB_NAME=landvault
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5433
SERVER_PORT=8080

# The application's OWN runtime connection — deliberately not the postgres
# superuser above, which Liquibase alone still uses for migrations. A
# superuser bypasses row-level security unconditionally, which would make
# every RLS policy silently inert. See AGENTS.md. Liquibase creates this
# role itself (changeset 019) using these exact credentials — change the
# password here freely for local dev, migrations will pick it up.
APP_DB_USERNAME=landvault_app
APP_DB_PASSWORD=change-me-local-dev-only

# Deliberately too short to pass the app's own weak-key check at startup
# (HS256 needs 256+ bits) — the app will refuse to start until this is
# replaced, even locally. Generate a real one with:
#   openssl rand -base64 32
# Production MUST use a strong, randomly generated secret — never this value,
# and never the same secret across environments.
JWT_SECRET=change-me-not-a-real-secret

# The frontend dev origin CORS allows. Comma-separated if more than one.
CORS_ALLOWED_ORIGINS=http://localhost:8443

# Creates the platform's first Super Admin account on startup — the only
# way one can ever exist, since registration can only create buyers. See
# AGENTS.md. Leave BOOTSTRAP_SUPER_ADMIN unset/false normally: set these,
# restart the app ONCE, confirm you can log in, then unset
# BOOTSTRAP_SUPER_ADMIN again (or just leave it — a second run is a no-op
# once an account holds the role, but there's no reason to keep asking).
# Never commit real values here.
BOOTSTRAP_SUPER_ADMIN=false
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_FIRST_NAME=Super
BOOTSTRAP_SUPER_ADMIN_LAST_NAME=Admin
BOOTSTRAP_SUPER_ADMIN_PASSWORD=change-me-first-run-only
